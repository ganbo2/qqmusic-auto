<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="网络北京时间：校时中..."
            android:textSize="14sp"
            android:background="#EEF2FF"
            android:padding="10dp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnResync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="重新校时（可多次点，对比偏差是否稳定）" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 开启无障碍服务" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="定时点击时间（北京时间；请提前手动打开 QQ音乐「立即提现」页面）" />

        <LinearLayout
            android:id="@+id/containerTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋ 添加点击时间" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="目标按钮文字（默认：立即提现）" />

        <EditText
            android:id="@+id/etTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="立即提现" />

        <CheckBox
            android:id="@+id/cbLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="（可选）时间到自动打开 QQ音乐" />

        <CheckBox
            android:id="@+id/cbUseCoord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="用坐标点击（适合「立即提现」这类图片按钮，推荐勾选）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="点击位置（占屏幕宽/高的百分比，0~100）。默认水平中点、靠底部。用「立即测试一次」校准。" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X%"
                android:layout_gravity="center_vertical" />

            <EditText
                android:id="@+id/etCoordX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Y%"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp" />

            <EditText
                android:id="@+id/etCoordY"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:hint="90" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="到点后延迟（毫秒）：正数=到点再等这么久才点击（越晚越不抢跑）；负数=提前这么久点击（抢跑，适合名额开放前就点）；0=整点立刻点。默认 300。" />

        <EditText
            android:id="@+id/etBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number|textPassword"
            android:hint="300（-5000~5000，负数=提前点击）" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2. 保存并启用定时任务" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#FFF8E1"
            android:text="北京时间 校时中..." />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即测试一次（现在就点）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="点击日志：每次自动点击后可手动标记成功/失败。点击某条可标记，长按删除，可清空。" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnRefreshLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="刷新日志" />

            <Button
                android:id="@+id/btnExportLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="备份日志" />

            <Button
                android:id="@+id/btnImportLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="恢复日志" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="清空日志" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            android:textColor="#999"
            android:text="版本" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:layout_marginTop="6dp"
            android:background="#F7F7F7"
            android:scrollbars="vertical"
            android:scrollbarSize="6dp"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/containerLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
